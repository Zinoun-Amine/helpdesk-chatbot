# ============================================================
# Variables d'environnement — Chatbot AUTOHALL Helpdesk
# Copiez ce fichier en .env et adaptez les valeurs
# ============================================================

# ── Base de données PostgreSQL ────────────────────────────────
DATABASE_URL=postgresql+asyncpg://chatbot:chatbot_pass@postgres:5432/chatbot_db
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=chatbot_pass
POSTGRES_DB=chatbot_db

# ── Redis (cache + rate limiting) ─────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Ollama (serveur LLM local - Fallback final) ────────────────
# Two common workflows:
# 1) Use a host-installed Ollama (recommended for local dev):
#    set `OLLAMA_BASE_URL=http://host.docker.internal:11434` so the
#    backend (running in Docker) talks to the host Ollama service.
# 2) Use the Dockerized `ollama` service: keep `OLLAMA_BASE_URL=http://ollama:11434`
#    and either install models into the container or mount your host ~/.ollama into it.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_API_KEY=
OLLAMA_NUM_PREDICT=512
OLLAMA_ONLY=True

# ── GLPI REST API (laisser désactivé jusqu'à renseigner les accès) ──
GLPI_ENABLED=false
GLPI_BASE_URL=https://glpi.example.com
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=
# Alternative à GLPI_USER_TOKEN :
GLPI_USERNAME=
GLPI_PASSWORD=
GLPI_ENTITY_ID=
GLPI_REQUESTER_ID=

# ── SMTP ────────────────────────────────────────────────────────
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=ton-adresse@gmail.com
SMTP_PASSWORD=TON_MOT_DE_PASSE_APPLICATION
SMTP_FROM=ton-adresse@gmail.com
SMTP_RECIPIENT=support@autohall.ma
SMTP_USE_TLS=false
SMTP_USE_STARTTLS=true
# Envoi automatique après création d'un ticket ; false = brouillon validé dans l'interface
SMTP_AUTO_SEND=true

# ── Cloud LLMs (Groq & Gemini - Fallback prioritaire) ─────────
# Renseignez vos clés API si vous souhaitez utiliser le système de fallback
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ENABLE_FALLBACK=False
PROVIDER_PRIORITY=["ollama"]

# ── ChromaDB (base vectorielle RAG) ──────────────────────────
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# ── Application ──────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Rate limiting ─────────────────────────────────────────────
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# ── Cache TTL (secondes) ──────────────────────────────────────
CACHE_TTL_SECONDS=300
